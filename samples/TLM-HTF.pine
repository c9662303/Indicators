swing_high_color = input.color(color.new(#0f0f0f, 0), title="High Line Color", group=group_swing, inline="swing_col")
swing_low_color = input.color(color.new(#0f0f0f, 0), title="Low Line Color", group=group_swing, inline="swing_col")
